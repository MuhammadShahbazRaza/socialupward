# ── Database (Vercel Postgres or Supabase) ─────────────────────────────
# Vercel Postgres (pooled connection recommended for serverless):
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connection_limit=1"
# Supabase (use the pooler URL):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true"

# ── Admin panel ──────────────────────────────────────────────────────────
# Password that unlocks /admin. Pick something long and random.
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# ── Stripe (payments) ────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://socialupward.com"
